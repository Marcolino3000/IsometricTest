.item-bar-root {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
}

.item-bar {
    flex-direction: row;
    margin-bottom: 20px;
    padding-top: 8px;
    padding-right: 4px;
    padding-bottom: 8px;
    padding-left: 4px;
    background-color: rgba(18, 18, 22, 0.75);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* Border width stays constant across every state so selecting or hovering a slot
   only swaps colors and never reflows the row. */
.slot {
    width: 96px;
    height: 96px;
    margin-right: 4px;
    margin-left: 4px;
    background-color: rgba(40, 40, 48, 0.9);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgba(255, 255, 255, 0.25);
    border-right-color: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.25);
    border-left-color: rgba(255, 255, 255, 0.25);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* First slot of a category. The row is grouped by what its slots are for, so the three actives read
   as one thing rather than as three of nine, and the gap says where one category ends. Declared
   after .slot so it wins on the margin; picker entries never get it. */
.slot--group-start {
    margin-left: 22px;
}

.slot:hover {
    border-top-color: rgba(255, 255, 255, 0.65);
    border-right-color: rgba(255, 255, 255, 0.65);
    border-bottom-color: rgba(255, 255, 255, 0.65);
    border-left-color: rgba(255, 255, 255, 0.65);
}

.slot--selected {
    background-color: rgba(70, 68, 30, 0.9);
    border-top-color: rgb(231, 227, 86);
    border-right-color: rgb(231, 227, 86);
    border-bottom-color: rgb(231, 227, 86);
    border-left-color: rgb(231, 227, 86);
}

/* The slot whose weapon is the one in hand. Both slots keep showing what they hold, so the fill is
   what tells the drawn one from the stowed one. Same look as a selected picker entry. */
.slot--active {
    background-color: rgba(70, 68, 30, 0.9);
    border-top-color: rgb(231, 227, 86);
    border-right-color: rgb(231, 227, 86);
    border-bottom-color: rgb(231, 227, 86);
    border-left-color: rgb(231, 227, 86);
}

/* The slot whose picker is open. Only the border brightens, so the yellow fill stays the mark of
   the entry that would be taken. */
.slot--open {
    border-top-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
}

/* Column of the items that fit one slot, anchored to its top center and growing upward.
   column-reverse puts the first entry closest to the slot it belongs to. */
.slot-picker {
    position: absolute;
    display: none;
    flex-direction: column-reverse;
    align-items: center;
    translate: -50% -100%;
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    background-color: rgba(18, 18, 22, 0.9);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.35);
    border-right-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(255, 255, 255, 0.35);
    border-left-color: rgba(255, 255, 255, 0.35);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* Same look as a slot, a size smaller: the row stays the thing the eye measures against.
   Declared after .slot so it wins on equal specificity. */
.slot--option {
    width: 72px;
    height: 72px;
    margin-top: 4px;
    margin-right: 0;
    margin-bottom: 4px;
    margin-left: 0;
}

/* The symbol is set as a background image, so it is scaled to fit the slot here rather than by
   whatever size the sprite happens to have. */
.slot__icon {
    flex-grow: 1;
    margin-top: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
    margin-left: 6px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

/* The category's colour, worn by every slot of it whether or not it holds anything - which is the
   point of it: the row has to say what each slot is for before anything has been found to put in it.
   Along the bottom edge rather than in the frame, where the yellow of an item in use already lives.
   Left uncoloured it draws nothing, which is what a picker entry does with it. */
.slot__accent {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* The category's symbol standing in for an item the slot does not hold. Faded, so it reads as a
   place for something rather than as something. */
.slot__icon--ghost {
    opacity: 0.22;
}

.slot__hotkey {
    position: absolute;
    bottom: 7px;
    right: 6px;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: bold;
}
